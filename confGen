#!/bin/bash

# 定义容器名称
service_name=$1
# 获取实例个数
instances=${2:-3}
# 定义端口映射起始端口号
port_start=$3
# 定义端口模式
port_mode=$4 

echo '' > "${service_name}.yml"
cat <<EOF >> "${service_name}.yml"
version: '3.8'
services:
EOF

# 生成端口映射配置文件
for (( i=1; i<=$instances; i++ ))
do
	if [ $port_mode -eq 1 ]; then
		port1=$(($port_start+$i-1))
		cat <<EOF >> "${service_name}.yml"
  ${service_name}${i}:
    build:
      args:
        NACOS_IP: \$NACOS_IP
        HOST_IP: \$HOST_IP
        SERVER_PORT: ${port1}
      context: ./chatspace-${service_name}
      dockerfile: Dockerfile
    ports:
      - "${port1}:${port1}"
EOF
	fi
	if [ $port_mode -eq 2 ]; then
	    # 计算端口映射
	    port1=$(($port_start + ($i-1)*2))
	    port2=$(($port_start + ($i-1)*2 + 1))

	    # 生成配置文件
	    cat <<EOF >> "${service_name}.yml"
  ${service_name}${i}:
    build:
      args:
        NACOS_IP: \$NACOS_IP
        HOST_IP: \$HOST_IP
        SERVER_PORT: ${port1}
        JVM_PORT: ${port2}
      context: ./chatspace-${service_name}
      dockerfile: Dockerfile
    ports:
      - "${port1}:${port1}"
      - "${port2}:${port2}"
EOF
	fi
	if [ $port_mode -eq 3 ]; then
        # 计算端口映射
        port1=$(($port_start + ($i-1)*3))
        port2=$(($port_start + ($i-1)*3 + 1))
        port3=$(($port_start + ($i-1)*3 + 2))

        # 生成配置文件
        cat <<EOF >> "${service_name}.yml"
  ${service_name}${i}:
    build:
      args:
        NACOS_IP: \$NACOS_IP
        HOST_IP: \$HOST_IP
        SERVER_PORT: ${port1}
        JVM_PORT: ${port2}
        MANAGEMENT_PORT: ${port3}
      context: ./chatspace-${service_name}
      dockerfile: Dockerfile
    ports:
      - "${port1}:${port1}"
      - "${port2}:${port2}"
      - "${port3}:${port3}"
EOF

	fi
	if [ $port_mode -eq 4 ]; then
        # 计算端口映射
        port1=$(($port_start + ($i-1)*4))
        port2=$(($port_start + ($i-1)*4 + 1))
        port3=$(($port_start + ($i-1)*4 + 2))
        port4=$(($port_start + ($i-1)*4 + 3))
        
		# 生成配置文件
        cat <<EOF >> "${service_name}.yml"
  ${service_name}${i}:
    build:
      args:
        NACOS_IP: \$NACOS_IP
        HOST_IP: \$HOST_IP
        SERVER_PORT: ${port1}
        JVM_PORT: ${port2}
        MANAGEMENT_PORT: ${port3}
        REGISTER_PORT: ${port4}
      context: ./chatspace-${service_name}
      dockerfile: Dockerfile
    ports:
      - "${port1}:${port1}"
      - "${port2}:${port2}"
      - "${port3}:${port3}"
      - "${port4}:${port4}"
EOF

	fi

done

