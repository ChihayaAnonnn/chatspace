              <boolProp name="resetInterpreter">false</boolProp>
              <stringProp name="script">import java.lang.*;
import java.math.*;

int index = Integer.parseInt(vars.get(&quot;index&quot;)) + 1;
int pathLen = Integer.parseInt(vars.get(&quot;pathLen&quot;));
index = index % pathLen;
vars.put(&quot;index&quot;, &quot;&quot; + index);
log.info(&quot;index:&quot; + index + &quot;pathLen:&quot; + pathLen);
int[] x = vars.getObject(&quot;xArray&quot;);
int[] y = vars.getObject(&quot;yArray&quot;);
vars.put(&quot;x&quot;, &quot;&quot; + x[index]);
vars.put(&quot;y&quot;, &quot;&quot; + y[index]);
log.info(&quot;【坐标】&quot; + x[index] + &quot;, &quot; + y[index]);</stringProp>
            </BeanShellPreProcessor>
