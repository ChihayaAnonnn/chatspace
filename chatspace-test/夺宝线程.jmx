        <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="路径数组化" enabled="true">
          <boolProp name="resetInterpreter">false</boolProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="script">import java.lang.*;
import java.math.*;

// 读取出路径字符串
String[] pathArray = vars.get(&quot;pathString&quot;).split(&quot;;&quot;);
int pathLen = pathArray.length;
vars.put(&quot;pathLen&quot;, &quot;&quot; + pathLen);

// 获取起始坐标
Random r = new Random();
int startX = Integer.parseInt(vars.get(&quot;startX&quot;));
int startY = Integer.parseInt(vars.get(&quot;startY&quot;));

// 构建路径数组
int[] xArray = new int[pathLen];
int[] yArray = new int[pathLen];
for (int i=0; i&lt;pathLen; i++) {
	switch (pathArray[i]) {
		case &quot;w&quot;: startY--; break;
		case &quot;s&quot;: startY++; break;
		case &quot;a&quot;: startX--; break;
		case &quot;d&quot;: startX++; break;
	}
	xArray[i] = startX;
	yArray[i] = startY;
}

// 保存路径长度和坐标数组
vars.putObject(&quot;xArray&quot;, xArray);
vars.putObject(&quot;yArray&quot;, yArray);</stringProp>
        </BeanShellPreProcessor>
